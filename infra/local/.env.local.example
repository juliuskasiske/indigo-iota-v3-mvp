# Local-preview environment. Copy to infra/local/.env.local and tweak.
# infra/local/.env.local is gitignored.
#
# The local-preview api container reads TWO env files (see the api `env_file`
# list in docker-compose.local.yml): backend/.env first, then this file, which
# overrides on any shared key. The LLM key + SESSION_SECRET live ONLY in
# backend/.env so there's a single copy that can't drift blank here.
#
# These are LOCAL-ONLY defaults: weak secrets and dev-login are fine here and
# MUST NOT be used in prod (see infra/prod/.env.prod.example for the real ones).

# --- Postgres (local container) ---
POSTGRES_USER=iota
POSTGRES_PASSWORD=iota
POSTGRES_DB=iota_brain
DATABASE_URL=postgresql://iota:iota@db:5432/iota_brain
CONTROL_DATABASE_URL=postgresql://iota:iota@db:5432/iota_control

# --- Auth / SSO ---
# Plain HTTP locally, so cookies CANNOT be Secure (they wouldn't be set).
IOTA_COOKIE_SECURE=0
# Enable POST /auth/dev-login so you can get a session without Microsoft and
# see the role-gated Admin surfaces locally. NEVER enable in prod.
IOTA_DEV_LOGIN=1
APP_BASE_URL=http://localhost:8080

# --- Secret-box key (encrypts stored connector secrets, e.g. IMAP passwords) ---
# Fernet key held OUTSIDE the DB; used by src/secret_box.py to encrypt/decrypt
# IMAP app passwords at rest. Generate with:
#   python -c "from src import secret_box; print(secret_box.generate_key())"
# Local-only value — in prod source a distinct key from a secrets manager.
IOTA_SECRET_KEY=

# --- LLMBase + SESSION_SECRET come from backend/.env ---
# Sourced from backend/.env (the first env_file in the api service) so the LLM
# key lives in ONE place. To run live extraction locally, set LLM_BASE_API_KEY
# in backend/.env, not here.

# --- Microsoft Graph (optional locally; use --from-file for offline ingest) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Cert auth (prod-style): keypair is mounted read-only at /secrets in the api
# container (host: backend/secrets/, gitignored). Leave GRAPH_CLIENT_SECRET
# blank when using these.
GRAPH_CLIENT_CERT_PATH=/secrets/iota-mail.crt
GRAPH_CLIENT_KEY_PATH=/secrets/iota-mail.key

# --- Google Drive (folder connector — ONE shared service account) ---
# Create a service account in Google Cloud (project → enable "Google Drive API"
# → create service account → download JSON key). Customers share a Drive folder
# with this email and we read it. Leave BLANK to leave the Drive "Connect" flow
# in its harmless "not configured" state.
GDRIVE_SERVICE_ACCOUNT_EMAIL=
# The JSON key as a SINGLE LINE (minify with:
#   python3 -c "import json; print(json.dumps(json.load(open('key.json'))))" )
# or a path to the key file mounted into the container. Leave blank if unused.
GDRIVE_SERVICE_ACCOUNT_JSON=

# --- Outbound transactional mail (SMTP) ---
# Sends invites / password-reset / first-admin set-up links. SENDING only —
# no IMAP here (that's the ingestion side). Leave IOTA_SMTP_HOST blank to use
# the dev fallback: nothing goes over the network, the full message (incl. the
# link) is written to the `iota.mailer` container log so the flow still works.
# To send for real, set the host + credentials from your mail provider.
#   IOTA_SMTP_SECURITY: "starttls" (port 587, default), "ssl" (port 465), "none"
# Deliverability: the From domain needs SPF/DKIM/DMARC DNS pointing at this
# provider or mail will be spam-foldered/rejected.
IOTA_SMTP_FROM=Indigo Iota <noreply@indigo-iota.com>
# Resend SMTP gateway (recommended — DKIM/SPF managed via Resend domain verification):
#   HOST=smtp.resend.com  PORT=465  USERNAME=resend  PASSWORD=re_...  SECURITY=ssl
# Leave HOST blank for dev fallback: message (with link) is logged, nothing sent.
IOTA_SMTP_HOST=
IOTA_SMTP_PORT=465
IOTA_SMTP_USERNAME=resend
IOTA_SMTP_PASSWORD=
IOTA_SMTP_SECURITY=ssl

# --- EntraID SSO (shared Login app) ---
# The Login app is ONE shared registration reused for every customer. Both its
# client id and secret live here (not per tenant): the id so onboarding only ever
# needs the customer's tenant id, the secret because it must never hit the DB.
# Leave blank locally unless testing live sign-in; source from a secrets manager
# in prod.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
