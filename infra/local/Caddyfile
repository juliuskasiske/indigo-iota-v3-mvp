# Local-preview Caddy config: plain HTTP on :80 (mapped to localhost:8080),
# no TLS, no ACME. Same routing as prod (infra/prod/Caddyfile) so same-origin
# behavior — cookies, /api, /auth — matches the deployed stack exactly.
#
# ':80' is a catch-all site (any Host), which is what we want behind a local
# port map. This file is mounted over the image's baked Caddyfile at runtime.
:80 {
	encode zstd gzip

	@api path /api/* /auth/* /healthz /mcp /mcp/* /authorize /token /register /revoke /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
