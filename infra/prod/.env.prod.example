# Production environment for the Hetzner box.
# Copy to infra/prod/.env.prod on the server, fill in, then: chmod 600 .env.prod
# NEVER commit .env.prod (it is gitignored).


# ---------------------------------------------------------------------------
# PUBLIC SITE
# ---------------------------------------------------------------------------

# The domain your app is served on. Caddy (the web server inside Docker) reads
# this and automatically gets a free TLS/HTTPS certificate from Let's Encrypt.
# Must match the DNS A record you pointed at this server.
APP_DOMAIN=app.indigo-iota.com

# The email address Let's Encrypt sends certificate expiry warnings to.
# Not a secret — just needs to be a real address you check occasionally.
ACME_EMAIL=hey@indigo-iota.com

# The full HTTPS URL of the app. The backend uses this when it needs to build
# an absolute URL, e.g. the redirect link after a user logs in, or the OAuth
# callback URL it tells external services to use. Must match APP_DOMAIN.
APP_BASE_URL=https://app.indigo-iota.com

# These two control what the MCP server (the Claude/ChatGPT connector) tells
# clients about where to find it. They default to APP_BASE_URL above, so you
# almost never need to set them. Only uncomment if the MCP endpoint lives on
# a different domain than the main app — which it doesn't here.
# MCP_ISSUER_URL=https://app.indigo-iota.com
# MCP_RESOURCE_URL=https://app.indigo-iota.com/mcp


# ---------------------------------------------------------------------------
# POSTGRES DATABASE
# ---------------------------------------------------------------------------

# The username the app uses to connect to Postgres. Not a secret by itself
# but needs to match across all three DATABASE_URL values below.
POSTGRES_USER=iota

# The password for the Postgres user above. This is the one secret that
# protects direct database access. Generate a strong random one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: whatever you put here must also appear in DATABASE_URL and
# CONTROL_DATABASE_URL below — they are the same password in three places.
POSTGRES_PASSWORD=CHANGE_ME

# The name of the default database Postgres creates on first boot.
# Must match the database name at the end of DATABASE_URL below.
POSTGRES_DB=iota_brain

# Full connection string for the main brain database. The app uses this to
# store entities, relationships, embeddings, brain pages etc.
# 'db' is not a typo — it's the hostname of the Postgres container inside
# Docker's internal network. From outside Docker it would be 'localhost'.
DATABASE_URL=postgresql://iota:CHANGE_ME@db:5432/iota_brain

# Full connection string for the control plane database. This is a separate
# database (on the same Postgres server) that stores the list of organisations,
# users, roles, and which database belongs to which customer. It's what lets
# the app be multi-tenant — it's the index that maps "customer A" to their DB.
# Created automatically on first boot if it doesn't exist yet.
CONTROL_DATABASE_URL=postgresql://iota:CHANGE_ME@db:5432/iota_control


# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------

# A secret string used to sign session cookies. When a user logs in, the app
# creates a cookie containing their user ID and role. This secret is used to
# cryptographically sign that cookie so it can't be forged or tampered with.
# If you change this, all existing sessions are immediately invalidated (everyone
# gets logged out). Generate a strong random one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME

# Whether to mark session cookies as Secure (HTTPS only). Must be 1 in
# production — without this, browsers will send the cookie over plain HTTP,
# which would expose session tokens to anyone watching the network.
IOTA_COOKIE_SECURE=1

# The dev login bypass (POST /auth/dev-login) skips the real login flow and
# lets anyone in with just an email. NEVER enable this in production — it
# would let anyone log in as any user without a password.
IOTA_DEV_LOGIN=0


# ---------------------------------------------------------------------------
# SECRET BOX (connector credential encryption)
# ---------------------------------------------------------------------------

# A symmetric encryption key used to encrypt sensitive connector credentials
# (e.g. IMAP passwords) before storing them in the database. Think of it as
# a master key for all stored passwords. It is kept here, outside the DB, so
# that even if someone steals a database backup they can't decrypt the stored
# passwords without this key.
# Generate once — if you lose it or change it, all stored connector passwords
# become unreadable and need to be re-entered:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IOTA_SECRET_KEY=CHANGE_ME


# ---------------------------------------------------------------------------
# LLM (AI model for email extraction)
# ---------------------------------------------------------------------------

# API key for LLMBase — the EU-hosted AI provider we use for reading emails
# and extracting people, companies and relationships from them. This is what
# costs money per email processed. Get it from your LLMBase account dashboard.
LLM_BASE_API_KEY=CHANGE_ME

# The base URL for the LLMBase API. LLMBase is OpenAI-compatible so the app
# talks to it like it would talk to OpenAI, just pointed at this URL instead.
LLM_BASE_BASE_URL=https://api.llmbase.ai/v1

# The default model: high-volume comprehension, the page-update agent, and every
# agent-swarm role that has no override below.
#
# Do NOT put a reasoning model here. Reasoning tokens come out of the same budget
# as the answer, so on a long email the identifier agent spends its whole
# allowance thinking and returns no content at all — extraction then silently
# falls back to empty. openai/gpt-oss-20b was the default here and did exactly
# that (463 of 500 tokens on reasoning, finish_reason=length, content=None).
LLM_BASE_MODEL=deepseek/deepseek-v4-flash

# Q&A and the delivery agent: answering questions over the whole brain needs more
# reasoning than extracting one email. MUST be a model your endpoint actually
# serves — check `GET /v1/models`. Leave unset to reuse LLM_BASE_MODEL.
LLM_QA_MODEL=deepseek/deepseek-v4-pro

# Optional per-role overrides for the agent swarm. The roles are not equally
# hard: cutting an objective into a genuinely mutually-exclusive set, and judging
# whether the evidence really carries a number, are the two that visibly suffer
# on a cheap model. Everything unset falls back to LLM_BASE_MODEL.
# Roles: FRAMER, DECOMPOSITION, INITIATIVE, VALIDATOR, PLANNING, SIZER, JUDGE
# LLM_MODEL_DECOMPOSITION=moonshotai/kimi-k2.6
# LLM_MODEL_JUDGE=moonshotai/kimi-k2.6

# Optional: how many emails to process simultaneously. Higher = faster but
# costs more API credits at once. Default is 4 if not set.
# LLM_BASE_MAX_CONCURRENCY=4


# ---------------------------------------------------------------------------
# MICROSOFT GRAPH (mail connector for customers using Microsoft 365)
# ---------------------------------------------------------------------------

# These credentials let the app read emails from a customer's Microsoft 365
# mailbox. They come from an "App Registration" you create in the customer's
# Microsoft Entra (Azure AD) admin portal during onboarding.
# Leave blank until you are onboarding a real customer.

# The customer's Microsoft tenant ID — identifies which Microsoft organisation
# we are connecting to. Found in Entra admin → Overview.
GRAPH_TENANT_ID=

# The client ID of the app registration you created in the customer's Entra.
# Think of it as the "username" for the app itself (not a user).
GRAPH_CLIENT_ID=

# The client secret for the app registration. Think of it as the "password"
# for the app itself. Prefer a certificate (below) over this in production.
GRAPH_CLIENT_SECRET=

# Alternative to client secret: a certificate. More secure because there is
# no shared secret that can leak — the private key never leaves your server.
# Uncomment and point at the certificate files on the server.
# GRAPH_CLIENT_CERT_PATH=/run/secrets/graph_cert.pem
# GRAPH_CLIENT_KEY_PATH=/run/secrets/graph_key.pem


# ---------------------------------------------------------------------------
# GOOGLE DRIVE (folder connector — ONE shared service account for all customers)
# ---------------------------------------------------------------------------
#
# Set up once in Google Cloud Console: create a project, enable the "Google
# Drive API", create a service account, and download its JSON key. The customer
# then shares a Drive folder with the service account's email, and we read it.
# Leave both BLANK until you've done that — the Drive "Connect" flow simply
# shows "not configured" and nothing breaks.

# The service account's email address — looks like
#   indigo-iota-drive@<project-id>.iam.gserviceaccount.com
# This is the ONLY piece customers see: the address they share their folder with.
GDRIVE_SERVICE_ACCOUNT_EMAIL=

# The downloaded JSON key. Two ways to provide it — pick ONE:
#  (A) RECOMMENDED — point at a FILE. The compose mounts infra/prod/secrets/ into
#      the api + sync containers at /secrets (read-only), so just drop the key
#      file there and give its in-container path:
#        scp your-key.json  you@box:/opt/indigo-iota/infra/prod/secrets/gdrive-key.json
#        GDRIVE_SERVICE_ACCOUNT_JSON=/secrets/gdrive-key.json
#      Much cleaner than pasting a huge blob, and the key never touches this file.
#  (B) Or paste the key as a SINGLE LINE (no line breaks), minified with:
#        python3 -c "import json; print(json.dumps(json.load(open('key.json'))))"
#      e.g. GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"…", …}
GDRIVE_SERVICE_ACCOUNT_JSON=


# ---------------------------------------------------------------------------
# CONTROL TOWER (platform owner access)
# ---------------------------------------------------------------------------

# A passphrase that gives you (the platform owner) access to the Control Tower
# at /control — the internal admin panel where you manage all customers, see
# platform-wide usage, and provision new tenants. This is not tied to any user
# account in the DB. Keep it strong and separate from everything else.
# Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_OWNER_TOKEN=CHANGE_ME


# ---------------------------------------------------------------------------
# OUTBOUND EMAIL (password resets, invites, onboarding links)
# ---------------------------------------------------------------------------

# We use Resend (resend.com) as the email sending service. These settings
# tell the app how to connect to Resend's SMTP gateway to send transactional
# emails like "here is your invite link" or "reset your password".

# The from address users see in their inbox.
IOTA_SMTP_FROM=Indigo Iota <noreply@indigo-iota.com>

# Resend's SMTP server address. Does not change.
IOTA_SMTP_HOST=smtp.resend.com

# Port 465 = SMTP with SSL/TLS encryption (as opposed to port 587 = STARTTLS).
IOTA_SMTP_PORT=465

# Resend requires the username to literally be the string "resend". Not a typo.
IOTA_SMTP_USERNAME=resend

# Your Resend API key. Get it from resend.com → API Keys. This is the actual
# secret — anyone with this key can send emails from your domain.
IOTA_SMTP_PASSWORD=re_CHANGE_ME

# Which encryption method to use on the SMTP connection. 'ssl' pairs with
# port 465. Don't change this unless you change the port too.
IOTA_SMTP_SECURITY=ssl


# ---------------------------------------------------------------------------
# MICROSOFT ENTRA SSO (single sign-on for customer employees)
# ---------------------------------------------------------------------------

# When a customer employee clicks "Sign in with Microsoft", the app redirects
# them to Microsoft, Microsoft authenticates them, then redirects back with a
# token. These are the credentials for the ONE shared app registration in your
# own Microsoft tenant that handles all customer sign-ins.
# Leave blank until you have set this up in your own Entra portal.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# BACKUPS
# ---------------------------------------------------------------------------

# Optional: where to ship database dumps off-box. If blank, dumps are kept
# locally on the server only (in /opt/indigo-iota/backups/). To send them to
# a Hetzner Storage Box, set this to:
#   u123456@u123456.your-storagebox.de:backups/
BACKUP_REMOTE=

# Optional: a passphrase to encrypt dumps with GPG before they leave the box.
# If set, the dump is encrypted before rsync so even if the remote storage is
# compromised the data is unreadable. Leave blank to skip encryption.
BACKUP_PASSPHRASE=

# How many days of local dumps to keep before deleting old ones.
BACKUP_RETENTION_DAYS=14
