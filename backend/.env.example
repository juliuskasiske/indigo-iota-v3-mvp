# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Database ---
# DATABASE_URL = the single local dev / demo brain DB (reinit + dashboard use it).
# Local Postgres.app (must have the pgvector extension available):
DATABASE_URL=postgresql://localhost:5432/indigo_demo
# Or the docker compose DB (infra/docker-compose.yml):
# DATABASE_URL=postgresql://iota:iota@localhost:5433/indigo_demo

# CONTROL_DATABASE_URL = the shared control plane (organizations, users, roles,
# the tenant→database registry). Tenant brain DBs live on the SAME server and
# their URLs are derived from this one. If unset, it's derived from DATABASE_URL
# (database 'iota_control' on the same server).
CONTROL_DATABASE_URL=postgresql://localhost:5432/iota_control

# --- Auth / SSO (src/api) ---
# Secret that signs session + login cookies. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Where to send users after a successful login (the Next.js frontend).
APP_BASE_URL=http://localhost:3000
# Mark cookies Secure (HTTPS only). Set to 1 in production.
IOTA_COOKIE_SECURE=0
# DEV ONLY: enable POST /auth/dev-login (session without Microsoft). Never set in prod.
IOTA_DEV_LOGIN=0

# --- LLMBase (EU-hosted, OpenAI-compatible) ---
# Only needed for live extraction. Precomputed reinit runs without these.
LLM_BASE_API_KEY=
LLM_BASE_BASE_URL=https://api.llmbase.ai/v1
LLM_BASE_MODEL=openai/gpt-oss-20b
# Stronger model used ONLY for Q&A / brain inference (more thorough than the
# cheap default above). Optional — defaults to this if unset.
LLM_QA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: cap concurrent LLM calls (default 4).
# LLM_BASE_MAX_CONCURRENCY=4
